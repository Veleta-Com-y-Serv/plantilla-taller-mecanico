---
// Página no encontrada con el diseño del taller: banda carbón a todo el ancho, «404» enorme y franjas.
import Base from '../layouts/Base.astro';
import { site, tel } from '../data/site';
const telefono = site.contacto.telefono;
---

<Base titulo="Página no encontrada">
  <section class="banda-carbon rejilla-tecnica relative isolate overflow-hidden">
    <div class="contenedor grid min-h-[70svh] content-center gap-8 py-20 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <p class="antetitulo">Error 404</p>
        <h1 class="titulo-seccion">Esta página está en el foso</h1>
        <p class="mt-5 max-w-xl text-lg opacity-85">Puede que el enlace esté mal o que la página se haya movido. Vuelve al inicio o llámanos.</p>
        <p class="mt-9 flex flex-wrap gap-3">
          <a class="btn" href="/">Volver al inicio</a>
          {telefono && <a class="btn-sec" href={tel(telefono)}>{telefono}</a>}
        </p>
      </div>
      <p class="num text-[clamp(7rem,40vw,20rem)] leading-[.8] text-primario" aria-hidden="true">404</p>
    </div>
  </section>
</Base>
