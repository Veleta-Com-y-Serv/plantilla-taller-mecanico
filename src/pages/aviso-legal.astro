---
// Página adicional de ejemplo: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda-carbon rejilla-tecnica">
    <div class="contenedor py-16 md:py-24">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="titulo-seccion">Aviso legal y privacidad</h1>
    </div>
    <div class="franja" aria-hidden="true"></div>
  </section>
  <section class="banda-clara">
    <div class="contenedor grid gap-10 py-16 md:py-24 lg:grid-cols-[1fr_2fr] lg:gap-20">
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-lg opacity-80">Quién es responsable de esta web, qué datos tratamos cuando nos pides cita y cómo ejercer tus derechos.</p>
        <p class="mt-6"><a class="btn" href="/">Volver al inicio</a></p>
      </aside>
      <article class="texto-largo max-w-3xl">
        <h2>Quiénes somos</h2>
        <p>
          Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
            c.email || 'nuestro correo de contacto'
          }{c.telefono && ` o llamarnos al ${c.telefono}`}.
        </p>
        <h2>Qué datos tratamos</h2>
        <p>
          Solo los que nos envías al escribirnos o al pedir cita: nombre, teléfono, matrícula, coche y lo que le pasa. Los
          usamos para darte la cita y preparar el presupuesto. No los cedemos a nadie salvo obligación legal.
        </p>
        <h2>Cuánto tiempo los guardamos</h2>
        <p>El necesario para atender tu consulta y, después, el que marque la ley.</p>
        <h2>Tus derechos</h2>
        <p>
          Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
          puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
        </p>
        <h2>Cookies</h2>
        <p>Esta web no usa cookies de seguimiento.</p>
      </article>
    </div>
  </section>
</Base>
