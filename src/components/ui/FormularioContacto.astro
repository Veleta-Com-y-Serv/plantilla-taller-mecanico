---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con los campos en el cuerpo.
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// Modelos: `cita` (cita previa: nombre, teléfono, matrícula con aspecto de placa, coche, fecha preferida, qué le
// hacemos —opciones de servicios.items— y mensaje) y `contacto` (nombre, email o teléfono, mensaje).
// `prefijo` hace únicos los ids cuando hay varios formularios en la misma página.
import { site, tiposDeServicio } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; modelo?: 'cita' | 'contacto'; prefijo?: string }
const {
  boton = 'Enviar',
  class: clase = '',
  modelo = 'contacto',
  asunto = modelo === 'cita' ? `Cita previa desde la web de ${site.nombre}` : `Consulta desde la web de ${site.nombre}`,
  prefijo = 'f',
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const tipos = modelo === 'cita' ? tiposDeServicio() : [];
const id = (campo: string) => `${prefijo}-${campo}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  {
    modelo === 'contacto' ? (
      <>
        <div class="campo">
          <label for={id('nombre')}>Nombre</label>
          <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
        </div>
        <div class="campo">
          <label for={id('contacto')}>Email o teléfono</label>
          <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
        </div>
      </>
    ) : (
      <>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('nombre')}>Nombre</label>
            <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
          </div>
          <div class="campo">
            <label for={id('telefono')}>Teléfono</label>
            <input id={id('telefono')} name="telefono" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>
        </div>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('matricula')}>Matrícula</label>
            <div class="campo-matricula">
              <span class="campo-matricula-ue" aria-hidden="true">E</span>
              <input id={id('matricula')} name="matricula" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="0000 XXX" />
            </div>
          </div>
          <div class="campo">
            <label for={id('coche')}>Marca y modelo</label>
            <input id={id('coche')} name="coche" type="text" autocomplete="off" />
          </div>
        </div>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('fecha')}>Día que te viene bien</label>
            <input id={id('fecha')} name="fecha" type="date" />
          </div>
          {tipos.length > 0 ? (
            <div class="campo">
              <label for={id('servicio')}>¿Qué le hacemos?</label>
              <select id={id('servicio')} name="servicio">
                {tipos.map((t) => <option value={t}>{t}</option>)}
                <option value="Otro">Otro</option>
              </select>
            </div>
          ) : (
            <div class="campo">
              <label for={id('servicio')}>¿Qué le hacemos?</label>
              <input id={id('servicio')} name="servicio" type="text" />
            </div>
          )}
        </div>
      </>
    )
  }
  <div class="campo">
    <label for={id('mensaje')}>{modelo === 'cita' ? '¿Qué le notas al coche?' : 'Mensaje'}</label>
    <textarea id={id('mensaje')} name="mensaje" rows={modelo === 'cita' ? 3 : 5} required={modelo === 'contacto'}></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
