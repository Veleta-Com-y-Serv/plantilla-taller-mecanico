---
// Contacto: banda carbón partida 50/50 a sangre. A la izquierda, titular y datos de site.yaml → contacto en filas
// grandes (teléfono enorme en naranja, WhatsApp, email, dirección con enlace al mapa y horario). A la derecha,
// `imagen` (la fachada del taller) hasta el borde de la ventana. Si la sección «cita» no está activa, en su lugar
// sale el formulario de contacto. Solo se pinta lo que hay.
import { seccion, site, tel, whatsapp, mapa } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Icono from '../ui/Icono.astro';
import Imagen from '../ui/Imagen.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const conFormulario = !seccion('cita');
const botonForm = (s?.boton_formulario as string) || undefined;
const lado = conFormulario || s?.imagen;
---

{
  s && (
    <section id={id} class="banda-carbon">
      <div class:list={['partida', lado ? (conFormulario ? '' : 'partida--md') : 'contacto--solo']}>
        <div class:list={['partida-texto', lado ? 'partida-texto--izq' : 'contenedor']}>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          {s.texto && <p class="titular-texto">{s.texto}</p>}
          <ul class="contacto-datos">
            {c.telefono && (
              <li>
                <a class="dato dato--tel" href={tel(c.telefono)}>
                  <Icono nombre="telefono" tam={30} class="shrink-0" />
                  <span class="num">{c.telefono}</span>
                </a>
              </li>
            )}
            {c.whatsapp && (
              <li>
                <a class="dato" href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">
                  <Icono nombre="whatsapp" class="shrink-0" />
                  <span>WhatsApp {c.whatsapp}</span>
                </a>
              </li>
            )}
            {c.email && (
              <li>
                <a class="dato" href={`mailto:${c.email}`}>
                  <Icono nombre="correo" class="shrink-0" />
                  <span class="break-all">{c.email}</span>
                </a>
              </li>
            )}
            {c.direccion && (
              <li>
                <a class="dato" href={mapa(c.direccion)} rel="noopener" target="_blank">
                  <Icono nombre="mapa" class="shrink-0" />
                  <span>{c.direccion}</span>
                </a>
              </li>
            )}
            {c.horario && (
              <li>
                <p class="dato">
                  <Icono nombre="reloj" class="shrink-0" />
                  <span>{c.horario}</span>
                </p>
              </li>
            )}
          </ul>
        </div>
        {conFormulario ? (
          <div class="banda-clara">
            <div class="partida-texto partida-texto--der">
              <FormularioContacto modelo="contacto" prefijo={`${id}-f`} boton={botonForm} />
            </div>
          </div>
        ) : (
          s.imagen && (
            <div class="partida-foto">
              <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} />
            </div>
          )
        )}
      </div>
    </section>
  )
}

<style>
  .contacto--solo { grid-template-columns: 1fr !important; }
  .contacto-datos { display: grid; margin-top: 2.5rem; border-top: 1px solid color-mix(in srgb, var(--c-fondo) 18%, transparent); }
  .dato { display: flex; align-items: center; gap: 1rem; min-height: 3.5rem; padding-block: 1rem; text-decoration: none; font-weight: 600; overflow-wrap: anywhere; border-bottom: 1px solid color-mix(in srgb, var(--c-fondo) 18%, transparent); }
  .dato :global(svg) { color: var(--c-primario); }
  a.dato:hover span { text-decoration: underline; }
  .dato--tel { font-size: clamp(2.2rem, 4.6vw, 4rem); line-height: 1; white-space: nowrap; overflow-wrap: normal; color: var(--c-primario); padding-block: 1.25rem; }
</style>
