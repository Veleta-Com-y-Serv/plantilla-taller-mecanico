---
// Cita previa: banda partida 50/50 a sangre. A la izquierda (gris claro), titular, pasos numerados (`items:
// [{titulo, texto, icono}]`) y `nota` en sello. A la derecha, mitad carbón hasta el borde de la ventana con la
// foto `imagen` de fondo (opcional, muy velada) y el formulario de cita: nombre, teléfono, matrícula (con aspecto
// de placa), marca y modelo, día, qué le hacemos (los títulos de servicios.items) y mensaje. `boton_formulario`.
import { seccion } from '../../data/site';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
const botonForm = (s?.boton_formulario as string) || s?.cta?.texto || undefined;
---

{
  s && (
    <section id={id} class="partida">
      <div class="partida-texto partida-texto--izq banda-gris">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
        {s.texto && <p class="titular-texto">{s.texto}</p>}
        {items.length > 0 && (
          <ol class="cita-pasos">
            {items.map((it, i) => (
              <li>
                <span class="cita-num num" aria-hidden="true">{i + 1}</span>
                <div>
                  <p class="flex items-center gap-2 font-display text-2xl uppercase [font-stretch:condensed]">
                    {it.icono && <Icono nombre={it.icono} tam={22} class="shrink-0 text-acento" />}
                    {it.titulo}
                  </p>
                  {it.texto && <p class="mt-1 opacity-80">{it.texto}</p>}
                </div>
              </li>
            ))}
          </ol>
        )}
        {s.nota && <p class="cita-nota">{s.nota}</p>}
      </div>
      <div class="cita-panel banda-carbon relative isolate overflow-hidden">
        {s.imagen && <Imagen src={s.imagen} alt="" ancho={1200} alto={900} class="absolute inset-0 -z-20 h-full w-full object-cover" />}
        <div class="cita-velo absolute inset-0 -z-10" aria-hidden="true" />
        <div class="partida-texto partida-texto--der">
          <FormularioContacto modelo="cita" prefijo={`${id}-f`} boton={botonForm} />
        </div>
      </div>
    </section>
  )
}

<style>
  .cita-pasos { display: grid; gap: 1.5rem; margin-top: 2.5rem; }
  .cita-pasos li { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; align-items: start; padding-top: 1.5rem; border-top: 2px solid var(--c-texto); }
  .cita-num { display: grid; place-items: center; width: 3rem; height: 3rem; font-size: 1.9rem; background: var(--c-texto); color: var(--c-primario); clip-path: polygon(0 0, 100% 0, 100% 72%, 72% 100%, 0 100%); }
  .cita-nota { display: inline-flex; align-items: center; gap: .6rem; margin-top: 2.25rem; padding: .7rem 1rem; font-weight: 700; background: var(--c-primario); color: var(--sobre-primario); }
  .cita-velo { background: linear-gradient(160deg, color-mix(in srgb, var(--c-texto) 88%, transparent), color-mix(in srgb, var(--c-texto) 96%, transparent)); }
  .cita-panel { display: grid; align-content: center; }
  .cita-panel .partida-texto { position: relative; }
  .cita-panel :global(.formulario-aviso), .cita-panel :global(.campo-check) { color: var(--c-fondo); }
</style>
