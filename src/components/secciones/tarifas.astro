---
// Tarifas: banda carbón oscuro con rejilla técnica, como la pizarra del mostrador. Cabecera partida y, debajo,
// las tarifas agrupadas por `categoria` en columnas (hasta 3 a todo el ancho): nombre, línea de puntos y precio
// en naranja; `texto` debajo. `tarifas: [{nombre, texto, precio, categoria}]`; `precio` como texto
// («desde 69 €», «Gratis»): sin precio no sale precio. `nota` al pie. Sin tarifas solo se pinta el titular
// (o nada si tampoco hay texto).
import { seccion } from '../../data/site';
import type { Tarifa } from '../../data/site';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const tarifas = s ? s.tarifas.map((t) => ({ ...t, nombre: String(t.nombre || (t as any).titulo || '') })).filter((t) => t.nombre) : [];
const grupos: { nombre: string; filas: Tarifa[] }[] = [];
for (const t of tarifas) {
  const g = String(t.categoria || '').trim();
  let grupo = grupos.find((x) => x.nombre === g);
  if (!grupo) grupos.push((grupo = { nombre: g, filas: [] }));
  grupo.filas.push(t);
}
const columnas = Math.min(Math.max(grupos.length, 1), 3);
const hayAlgo = s && (tarifas.length > 0 || s.titulo || s.texto);
---

{
  s && hayAlgo && (
    <section id={Astro.props.id} class="banda-noche rejilla-tecnica seccion">
      <div class="contenedor">
        <div class="grid gap-6 lg:grid-cols-[1.25fr_1fr] lg:items-end lg:gap-16">
          <div>
            {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
            {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          </div>
          {s.texto && <p class="text-lg opacity-85 lg:pb-2">{s.texto}</p>}
        </div>
        {tarifas.length > 0 && (
          <div class="tarifas-grupos" style={`--cols:${columnas};--cols-md:${Math.min(columnas, 2)}`}>
            {grupos.map((g) => (
              <div class:list={['tarifas-grupo', { 'tarifas-grupo--solo': grupos.length === 1 }]}>
                {g.nombre && <h3 class="tarifas-categoria">{g.nombre}</h3>}
                <ul>
                  {g.filas.map((t) => (
                    <li class="tarifa">
                      <p class="tarifa-cabeza">
                        <span class="tarifa-nombre">{t.nombre}</span>
                        {t.precio && <span class="tarifa-puntos" aria-hidden="true" />}
                        {t.precio && <span class="tarifa-precio num">{t.precio}</span>}
                      </p>
                      {t.texto && <p class="tarifa-texto">{t.texto}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
        {(s.nota || s.cta) && (
          <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-5">
            {s.nota && (
              <p class="flex items-center gap-2 opacity-85">
                <Icono nombre="check" tam={20} class="shrink-0 text-primario" />
                {s.nota}
              </p>
            )}
            {s.cta && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .tarifas-grupos { display: grid; gap: 3rem; margin-top: 3.5rem; }
  @media (min-width: 900px) { .tarifas-grupos { grid-template-columns: repeat(var(--cols-md), minmax(0, 1fr)); column-gap: 3rem; } }
  @media (min-width: 1200px) { .tarifas-grupos { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: 4rem; } }
  @media (min-width: 900px) { .tarifas-grupo--solo ul { columns: 2; column-gap: 4rem; } }
  .tarifas-categoria { display: flex; align-items: center; gap: .75rem; padding-bottom: .9rem; margin-bottom: .5rem; font-size: 1.6rem; color: var(--c-primario); border-bottom: 3px solid var(--c-primario); }
  .tarifa { break-inside: avoid; padding-block: 1rem; border-bottom: 1px solid color-mix(in srgb, var(--c-fondo) 14%, transparent); }
  .tarifa-cabeza { display: flex; align-items: baseline; gap: .6rem; }
  .tarifa-nombre { font-weight: 700; font-size: 1.08rem; min-width: 0; }
  .tarifa-puntos { flex: 1; min-width: 1rem; border-bottom: 2px dotted color-mix(in srgb, var(--c-fondo) 35%, transparent); transform: translateY(-.3em); }
  .tarifa-precio { flex-shrink: 0; font-size: 1.6rem; line-height: 1; color: var(--c-primario); white-space: nowrap; }
  .tarifa-texto { margin-top: .3rem; font-size: .93rem; opacity: .7; }
</style>
